<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="400.0" prefWidth="600.0" stylesheets="@estilos.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controlador">
   <left>
      <VBox maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="299.0" prefWidth="176.0" stylesheets="@estilos.css" BorderPane.alignment="BOTTOM_CENTER">
         <BorderPane.margin>
            <Insets bottom="20.0" left="20.0" right="10.0" top="20.0" />
         </BorderPane.margin>
         <children>
            <Label text="Identificador">
               <VBox.margin>
                  <Insets />
               </VBox.margin>
            </Label>
            <TextField fx:id="l_Identificador" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity">
               <VBox.margin>
                  <Insets top="20.0" />
               </VBox.margin>
            </TextField>
            <Label text="Nombre Producto">
               <VBox.margin>
                  <Insets top="20.0" />
               </VBox.margin>
            </Label>
            <TextField fx:id="l_NombreProducto" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity">
               <VBox.margin>
                  <Insets top="20.0" />
               </VBox.margin>
            </TextField>
            <Label maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" text="Stock">
               <VBox.margin>
                  <Insets top="20.0" />
               </VBox.margin>
            </Label>
            <TextField fx:id="l_Stock" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity">
               <VBox.margin>
                  <Insets top="20.0" />
               </VBox.margin>
            </TextField>
         </children>
      </VBox>
   </left>
   <bottom>
      <Pane maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="90.0" prefWidth="228.0" BorderPane.alignment="BOTTOM_LEFT">
         <children>
            <Button fx:id="b_Agregar" layoutX="14.0" layoutY="14.0" mnemonicParsing="false" onAction="#onActionAgregar" prefHeight="30.0" prefWidth="85.0" stylesheets="@estilos.css" text="Agregar" />
            <Button fx:id="b_Modificar" layoutX="122.0" layoutY="14.0" mnemonicParsing="false" onAction="#onActionModificar" prefHeight="30.0" prefWidth="85.0" text="Modificar" />
         </children>
      </Pane>
   </bottom>
   <center>
      <TableView fx:id="tab_Producto" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="283.0" prefWidth="380.0" BorderPane.alignment="CENTER">
        <columns>
          <TableColumn fx:id="col_Identificador" prefWidth="102.0" text="Identificador" />
          <TableColumn fx:id="col_NomProducto" minWidth="-Infinity" prefWidth="171.0" resizable="false" text="Nom. Producto" />
            <TableColumn fx:id="col_Stock" minWidth="0.0" prefWidth="107.0" resizable="false" text="Stock" />
        </columns>
         <BorderPane.margin>
            <Insets left="10.0" right="20.0" top="30.0" />
         </BorderPane.margin>
         <padding>
            <Insets bottom="-1.0" left="-1.0" right="-1.0" top="-1.0" />
         </padding>
      </TableView>
   </center>
</BorderPane>
